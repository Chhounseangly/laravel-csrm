class {{ Name }}Controller extends BaseController
{
    public function __construct(
        private {{ Name }}RepositoryInterface ${{ variable }}Repository,
        private {{ Name }}Service ${{ variable }}Service
    ) {}

    public function index(): JsonResponse
    {
        $data = $this->{{ variable }}Repository->paginate();
        return $this->success($data);
    }

    public function store(Request $request): JsonResponse
    {
        ${{ variable }} = $this->{{ variable }}Service->create($request->validated());
        return $this->created(${{ variable }});
    }

    public function show(int|string $id): JsonResponse
    {
        ${{ variable }} = $this->{{ variable }}Repository->findOrFail($id);
        return $this->success(${{ variable }});
    }

